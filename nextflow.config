// ReRx Alpine pilot — Nextflow/Slurm configuration.
// Skill-proven pattern: head on Persistence1, Slurm executor, acpu
// partition, queueSize 200 (matches MaxJobs=200).
// Containers are invoked directly by the task driver via apptainer,
// so Nextflow itself needs no container scopes here.
// The allocation comes from the SLURM_ACCOUNT environment variable
// (no hard-coded personal allocation names).

process {
    executor       = 'slurm'
    queue          = 'acpu'
    clusterOptions = "--account=${System.getenv('SLURM_ACCOUNT') ?: 'amc-general'} --qos=cpu-normal"
    cpus   = 2
    memory = 4.GB
    time   = 2.h

    // Transient Slurm hiccups (node preemption, brief scheduler errors)
    // should not force a full pipeline rerun; retry a few times with
    // backoff before giving up. errorStrategy 'retry' resubmits the
    // same task; maxRetries caps it so a genuinely broken task still
    // fails the run instead of looping forever.
    errorStrategy = 'retry'
    maxRetries    = 2

    withName: PREPARE {
        cpus   = 2
        memory = 8.GB
        time   = 2.h
    }
    withName: CELLPROFILER {
        cpus   = 8
        memory = 32.GB
        // Download one shard's source PNGs before the CellProfiler run.
        time   = 3.h
        maxForks = 16
    }
    withName: CYTOTABLE {
        cpus   = 4
        memory = 32.GB
        time   = 1.h
        maxForks = 16
    }
    withName: CROPS {
        cpus   = 4
        memory = 16.GB
        time   = 1.h
        maxForks = 16
    }
    withName: MORPHEM {
        cpus   = 8
        memory = 64.GB
        time   = 2.h
        maxForks = 32
    }
    withName: FINALIZE_PLATE {
        // VERO plates can exceed 2.4M cells; one plate exhausted 128GB
        // on all three attempts. Keep shard tasks on acpu, but finalize
        // on high-memory nodes with 512GB, then 768GB/1024GB on retries.
        // 16GB per requested CPU stays below amem's per-CPU memory cap.
        queue          = 'amem'
        clusterOptions = "--account=${System.getenv('SLURM_ACCOUNT') ?: 'amc-general'} --qos=mem-normal"
        cpus           = { 16 * (task.attempt + 1) }
        memory         = { 256.GB * (task.attempt + 1) }
        time           = 12.h
        maxForks       = 2
    }
    withName: COMPLETE_FULL {
        // Catalog registration must not inherit a whole node's memory
        // budget. Give the final gate headroom and increase it on retry;
        // mem-normal requires at least 240GB per job. Start at 256GB;
        // the builder separately bounds DuckDB memory and worker threads.
        queue          = 'amem'
        clusterOptions = "--account=${System.getenv('SLURM_ACCOUNT') ?: 'amc-general'} --qos=mem-normal"
        cpus           = { 8 * (task.attempt + 1) }
        memory         = { 128.GB * (task.attempt + 1) }
        time           = 12.h
    }
    withName: FINALIZE {
        cpus   = 4
        memory = 64.GB
        time   = 2.h
        // Memory note (documented, not yet needing a change): the
        // driver streams per plate/shard (src/rerx/streaming.py) --
        // annotate/normalize/select and buscar run one plate's rows
        // at a time, and validation runs one shard at a time. So
        // memory scales with the LARGEST SINGLE PLATE, not the full
        // dataset. Pilot plate (~5,500 cells, ~1,500 CP features)
        // uses well under 1 GB; at full scale a plate can have up to
        // ~700 sites / many more cells, so if a future full-dataset
        // plate's per-cell feature table exceeds a few GB in memory,
        // raise this value (and/or cpus, since pandas ops here are
        // single-threaded) rather than reintroducing whole-dataset
        // concatenation in the driver.
    }
}

executor {
    queueSize = 200
    pollInterval = '20s'
    queueStatInterval = '1m'
    exitReadTimeout = '270s'
}

// Scratch location is provided by the environment (RERX_ROOT from
// scripts/alpine_launch.sh), never a hard-coded personal path.
workDir = System.getenv('RERX_NEXTFLOW_WORK') ?: "${System.getenv('RERX_ROOT')}/nextflow_work"
