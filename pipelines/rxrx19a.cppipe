MeasureImageQuality:[module_num:4|svn_version:'Unknown'|variable_revision_number:6|show_window:False|notes:['ReRx: per-image intensity/saturation/blur metrics on the DNA (w1 Hoechst) channel only -- the channel used for nuclei segmentation and the one that showed the Plate 25 AA08/E08 over-segmentation. Scoped to one channel (not all 5) because ExportToDatabase hits SQLite's Per_Image column limit otherwise. Added so a future dim-well problem shows up as an automatic per-image intensity outlier instead of requiring a manual Cellpose cross-check to notice (plan.md segmentation review).']|batch_state:array([], dtype=uint8)|enabled:True|wants_pause:False]
